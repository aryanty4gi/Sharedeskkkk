export const getOrCreateConversationAction = createServerFn({ method: "POST" })
  .inputValidator((d) => z.object({
    token: z.string(),
    otherUserId: z.string().uuid(),
  }).parse(d))
  .handler(async ({ data }) => {
    const { client, user } = await getAuthenticatedClient(data.token);
    const uid = user.id;

    if (uid === data.otherUserId) {
      throw new Error("You can't start a chat with yourself.");
    }

    const { data: mine, error: mineErr } = await client
      .from("conversation_participants")
      .select("conversation_id")
      .eq("user_id", uid);
    if (mineErr) throw new Error("Unable to load your conversations.");

    const myConvIds = (mine ?? []).map((r) => r.conversation_id);
    if (myConvIds.length) {
      const { data: shared } = await client
        .from("conversation_participants")
        .select("conversation_id")
        .eq("user_id", data.otherUserId)
        .in("conversation_id", myConvIds);
      if (shared && shared.length) return { conversationId: shared[0].conversation_id };
    }

    const { data: conv, error: convErr } = await client
      .from("conversations")
      .insert({ created_by: uid })
      .select("id")
      .single();
    if (convErr) {
      console.error("CREATE CONVERSATION SUPABASE ERROR:", {
        message: convErr.message,
        code: convErr.code,
        details: convErr.details,
        hint: convErr.hint,
      });

      throw new Error(
        `Unable to create conversation: ${convErr.message} [${convErr.code}]`
      );
    }
    const cid = conv.id;

    const { error: selfErr } = await client
      .from("conversation_participants")
      .insert({ conversation_id: cid, user_id: uid });
    if (selfErr) throw new Error("Unable to join the conversation.");

    const { error: otherErr } = await client
      .from("conversation_participants")
      .insert({ conversation_id: cid, user_id: data.otherUserId });
    if (otherErr) throw new Error("Unable to add the other participant.");

    return { conversationId: cid };
  });

export const toggleReactionAction = createServerFn({ method: "POST" })
  .inputValidator((d) => z.object({
    token: z.string(),
    messageId: z.string().uuid(),
    emoji: z.string().min(1),
  }).parse(d))
  .handler(async ({ data }) => {
    const { client, user } = await getAuthenticatedClient(data.token);
    
    const { data: existing } = await client
      .from("message_reactions")
      .select("id")
      .eq("message_id", data.messageId)
      .eq("user_id", user.id)
      .eq("emoji", data.emoji)
      .maybeSingle();
      
    if (existing) {
      await client.from("message_reactions").delete().eq("id", existing.id);
    } else {
      await client.from("message_reactions").insert({
        message_id: data.messageId,
        user_id: user.id,
        emoji: data.emoji,
      });
    }
    return { success: true };
  });

