    targetUserId: z.string().uuid(),
    department: z.string(),
    designation: z.string(),
    managerId: z.string().uuid().nullable(),
  }).parse(d))
  .handler(async ({ data }) => {
    const { client } = await getAuthenticatedClient(data.token);

    const { error } = await client.rpc("admin_update_employee", {
      target_user_id: data.targetUserId,
      new_department: data.department,
      new_designation: data.designation,
      new_manager_id: data.managerId ?? undefined,
    });

    if (error) throw new Error(error.message);

    return { success: true };
  });

